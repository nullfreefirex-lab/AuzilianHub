local MainTab = Window:CreateTab("Main", 4483362458)

local CoinsSection = MainTab:CreateSection("Claim Coins")

-- Variável global para controlar os loops
local loopControl = {}

-- Função para criar um loop para cada toggle
local function createLoop(toggleName, remoteAction, item)
    loopControl[toggleName] = false
    
    return function(Value)
        if Value then
            loopControl[toggleName] = true
            task.spawn(function()
                while loopControl[toggleName] do
                    game:GetService("ReplicatedStorage").RemoteEvents.mapManagerRemote:FireServer(remoteAction, item)
                    task.wait(0.1)
                end
            end)
        else
            loopControl[toggleName] = false
        end
    end
end

-- Toggles para coins
MainTab:CreateToggle({
   Name = "Claim 1.5k Coins",
   CurrentValue = false,
   Flag = "Toggle1",
   Callback = createLoop("Toggle1", "claimCoins", "1.5kCoinsGiver")
})

